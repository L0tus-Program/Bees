# Referência de configuração; carregue as variáveis no shell.
# O serviço não lê .env automaticamente e não precisa de credenciais nesta etapa.
BEES_HOST=127.0.0.1
BEES_PORT=8000
# Diretório absoluto opcional, caso o frontend compilado esteja em outro local:
# BEES_WEB_DIST=D:/repositorios_novos/bees/apps/web/dist
# Estado privado em filesystem local; padrão: data na raiz do checkout.
# BEES_DATA_DIR=D:/repositorios_novos/bees/data
BEES_CACHE_TTL_SECONDS=86400
BEES_CACHE_PRUNE_LIMIT=1000
