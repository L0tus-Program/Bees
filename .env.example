# Referência de configuração; carregue as variáveis no shell.
# O serviço e a CLI não leem .env automaticamente. No desenvolvimento, bootstrap é opcional do operador.
# A distribuição Compose configura tudo abaixo e o launcher autoriza primeiro acesso no navegador.
BEES_HOST=127.0.0.1
BEES_PORT=8000
# Diretório absoluto opcional, caso o frontend compilado esteja em outro local:
# BEES_WEB_DIST=D:/repositorios_novos/bees/apps/web/dist
# Estado privado em filesystem local; padrão: data na raiz do checkout.
# BEES_DATA_DIR=D:/repositorios_novos/bees/data
BEES_CACHE_TTL_SECONDS=86400
BEES_CACHE_PRUNE_LIMIT=1000
# Para modelo remoto, provisione privadamente a variável indicada em secret_ref.
# Referência de exemplo: env:BEES_REMOTE_API_KEY (não inserir valor neste arquivo).
# Acesso remoto: origem HTTPS exata, com proxy TLS no mesmo host.
# BEES_PUBLIC_URL=https://bees.seu-dominio.example
# Linux: chave Fernet gerada e guardada externamente pelo operador/supervisor.
# BEES_VAULT_KEY=<chave-secreta-externa> (não gravar a chave neste arquivo)
# Windows usa DPAPI CurrentUser e dispensa BEES_VAULT_KEY.

# Contrato da imagem Compose (não configurar manualmente no fluxo normal):
# BEES_DEPLOYMENT_MODE=container
# BEES_HOST=0.0.0.0
# BEES_BROWSER_PORT=8080
# BEES_VAULT_KEY_FILE=/run/bees-secrets/vault.key
# Não usar BEES_VAULT_KEY junto do arquivo gerenciado.
